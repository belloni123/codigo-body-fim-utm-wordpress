<script>
(() => {
    const page = new URL(window.location.href);
    const pagePath = page.pathname.replace(/^\/|\/$/g, '');
    const referrer = document.referrer.replace(/^https?:\/\//, '');
    const defaults = {
        utm_source: referrer || 'Direto',
        utm_medium: 'Organico',
        utm_campaign: 'Direto',
        utm_content: pagePath || 'Home',
        utm_term: ''
    };

    const tracking = new URLSearchParams();
    for (const [name, fallback] of Object.entries(defaults)) {
        tracking.set(name, page.searchParams.get(name) || fallback);
    }

    for (const link of document.querySelectorAll('a[href]')) {
        const href = link.getAttribute('href');
        if (!href.trim() || href.includes('#') || link.hasAttribute('popup')) continue;

        let destination;
        try {
            destination = new URL(href, document.baseURI);
        } catch {
            continue;
        }

        // Mantém intactos tel:, mailto:, whatsapp: e outros protocolos de apps.
        if (!['http:', 'https:'].includes(destination.protocol)) continue;

        const host = destination.hostname.replace(/\.$/, '');
        if (host === 'wa.me' || host === 'wa.link' ||
            host === 'whatsapp.com' || host.endsWith('.whatsapp.com')) continue;

        if (Object.keys(defaults).some(name => destination.searchParams.has(name))) continue;

        const params = new URLSearchParams(tracking);
        if ((host === 'pay.hotmart.com' || host === 'pay.kiwify.com.br') &&
            !destination.searchParams.has('sck')) {
            params.set('sck', Array.from(tracking.values()).join('-'));
        }

        const separator = destination.search ? '&' : '?';
        link.href = (destination.search ? destination.href : destination.href.replace(/\?$/, '')) + separator + params.toString();
    }
})();
</script>
